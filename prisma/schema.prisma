generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // Uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // Uses a direct connection
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   // SUPER_ADMIN, MANAGER, RECEPTIONIST, HR, FINANCE, FACULTY
  createdAt DateTime @default(now())
  
  passwordChangedAt DateTime?
  passwordChangedBy String?  // USER, SUPER_ADMIN, SYSTEM
  resetRequired     Boolean  @default(false)

  specialist Specialist?
}

model Specialist {
  id               String   @id @default(cuid())
  name             String
  designation      String
  qualifications   String
  experience       Int      // years
  languages        String
  bio              String
  category         String   @default("Special Educator") // Professional category
  specialization   String   @default("General")
  consultationType String   @default("In-Person") // e.g. In-Person, Online, Hybrid
  consultationFee  Float
  isActive         Boolean  @default(true)
  imageUrl         String?
  
  // New Fields
  advanceAmount    Float    @default(500)
  displayOrder     Int      @default(999)
  email            String?  @unique
  status           String   @default("ACTIVE") // PENDING_APPROVAL, ACTIVE, INACTIVE, REJECTED
  userId           String?  @unique
  user             User?    @relation(fields: [userId], references: [id])

  
  services       Service[]       @relation("SpecialistToService")
  availability   Availability[]
  appointments   Appointment[]
  lockedSlots    LockedSlot[]
}

model Service {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  imageUrl    String?
  
  specialists Specialist[] @relation("SpecialistToService")
}

// Defines weekly schedule (e.g., Monday 09:00 - 17:00)
model Availability {
  id           String     @id @default(cuid())
  specialistId String
  dayOfWeek    Int        // 0-6
  startTime    String     // "09:00"
  endTime      String     // "17:00"
  specialist   Specialist @relation(fields: [specialistId], references: [id])
}

// For leaves or admin locks
model LockedSlot {
  id           String     @id @default(cuid())
  specialistId String
  date         DateTime   // specific date
  startTime    String?    // If null, whole day is locked
  endTime      String?
  reason       String?
  specialist   Specialist @relation(fields: [specialistId], references: [id])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  
  children     Child[]
  appointments Appointment[]
  invoices     Invoice[]
  createdAt    DateTime @default(now())
  notes        CustomerNote[]
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  authorId   String?  // ID of the admin who created it
  authorName String?  // Name of the admin
  note       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Child {
  id           String   @id @default(cuid())
  customerId   String
  name         String
  dob          DateTime?
  age          Int?
  gender       String
  school       String?
  gradeClass   String?
  relationship String   // e.g., Mother, Father (context of the customer)
  
  customer     Customer @relation(fields: [customerId], references: [id])
  appointments Appointment[]
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?  // Admin who performed the action
  action    String   // e.g., "APPOINTMENT_CANCELLED"
  entity    String   // e.g., "Appointment"
  entityId  String
  details   String?
  createdAt DateTime @default(now())
}

model Appointment {
  id              String     @id @default(cuid())
  specialistId    String
  customerId      String
  childId         String
  date            DateTime
  startTime       String
  endTime         String
  status          String     // PENDING, CONFIRMED, CANCELLED, COMPLETED
  
  // New Payment Fields
  totalAmount     Float      @default(0)
  advanceAmount   Float      @default(0)
  advancePaid     Float      @default(0)
  balancePaid     Float      @default(0)
  paymentStatus   String     @default("PENDING") // PENDING, ADVANCE_PAID, PARTIALLY_PAID, FULLY_PAID, REFUNDED, CANCELLED
  
  reason             String
  additionalInfo     String?
  cancellationReason String?
  
  specialist      Specialist @relation(fields: [specialistId], references: [id])
  customer        Customer   @relation(fields: [customerId], references: [id])
  child           Child      @relation(fields: [childId], references: [id])
  payment         Payment?
  invoice         Invoice?
  transactions    Transaction[]
  
  createdAt       DateTime   @default(now())
}

// Temporary hold during checkout (10 mins)
model SlotHold {
  id           String   @id @default(cuid())
  specialistId String
  date         DateTime
  startTime    String
  expiresAt    DateTime
  
  @@unique([specialistId, date, startTime])
}

model Payment {
  id              String      @id @default(cuid())
  appointmentId   String      @unique
  razorpayOrderId String      @unique
  razorpayPaymentId String?
  amount          Float
  status          String      // PENDING, SUCCESS, FAILED, REFUNDED
  
  appointment     Appointment @relation(fields: [appointmentId], references: [id])
  createdAt       DateTime    @default(now())
}

model Transaction {
  id              String      @id @default(cuid())
  appointmentId   String
  amount          Float
  type            String      // ADVANCE, BALANCE, REFUND
  method          String      // RAZORPAY, CASH, UPI, CARD, BANK_TRANSFER, OTHER
  status          String      // SUCCESS, FAILED, REFUNDED
  reference       String?
  notes           String?
  date            DateTime    @default(now())
  
  appointment     Appointment @relation(fields: [appointmentId], references: [id])
}

model JobOpening {
  id           String   @id @default(cuid())
  title        String
  department   String
  location     String
  experience   String
  type         String   // Full-time, Part-time, Contract
  description  String
  requirements String?
  isPublished  Boolean  @default(true)
  closingDate  DateTime?
  isFilled     Boolean  @default(false)
  
  applications JobApplication[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model JobApplication {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String
  position       String
  category       String   @default("Consultant")
  jobOpeningId   String?
  jobOpening     JobOpening? @relation(fields: [jobOpeningId], references: [id])
  qualifications String
  experience     String
  currentOrg     String?
  specialisation String?
  resumeUrl      String
  photoUrl       String?
  message        String?
  status         String   // NEW, REVIEWING, SHORTLISTED, SELECTED, REJECTED, ACCEPTED, DECLINED
  metadata       Json?
  
  // Faculty Conversion Tracking
  convertedAt           DateTime?
  convertedSpecialistId String?
  convertedUserId       String?
  
  createdAt      DateTime @default(now())
}

model Setting {
  key   String @id
  value String
  
  updatedAt DateTime @updatedAt
}

model EmailLog {
  id        String   @id @default(cuid())
  type      String   // e.g., BOOKING_CONFIRMATION, REMINDER_24H
  recipient String
  subject   String
  status    String   // SUCCESS, FAILED
  relatedId String?  // ID of the Appointment or JobApplication
  error     String?
  
  createdAt DateTime @default(now())
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique // LL-INV-2026-0001
  appointmentId String   @unique
  customerId    String
  date          DateTime @default(now())
  pdfUrl        String?
  token         String   @unique // For secure access
  
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  customer      Customer    @relation(fields: [customerId], references: [id])
  createdAt     DateTime    @default(now())
}
