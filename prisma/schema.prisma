generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                String      @id @default(cuid())
  email             String      @unique
  password          String
  name              String
  role              String
  createdAt         DateTime    @default(now())
  passwordChangedAt DateTime?
  passwordChangedBy String?
  resetRequired     Boolean     @default(false)
  specialist        Specialist?
}

model Specialist {
  id               String         @id @default(cuid())
  name             String
  designation      String
  qualifications   String
  experience       Int
  languages        String
  bio              String
  category         String         @default("Special Educator")
  specialization   String         @default("General")
  consultationType String         @default("In-Person")
  consultationFee  Float
  isActive         Boolean        @default(true)
  imageUrl         String?
  advanceAmount    Float          @default(500)
  email            String?        @unique
  status           String         @default("ACTIVE")
  userId           String?        @unique
  displayOrder     Int            @default(999)
  appointments     Appointment[]
  availability     Availability[]
  lockedSlots      LockedSlot[]
  user             User?          @relation(fields: [userId], references: [id])
  services         Service[]      @relation("SpecialistToService")
}

model Service {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String
  imageUrl    String?
  specialists Specialist[] @relation("SpecialistToService")
}

model Availability {
  id           String     @id @default(cuid())
  specialistId String
  dayOfWeek    Int
  startTime    String
  endTime      String
  specialist   Specialist @relation(fields: [specialistId], references: [id])
}

model LockedSlot {
  id           String     @id @default(cuid())
  specialistId String
  date         DateTime
  startTime    String?
  endTime      String?
  reason       String?
  specialist   Specialist @relation(fields: [specialistId], references: [id])
}

model Customer {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  phone        String
  createdAt    DateTime       @default(now())
  appointments Appointment[]
  children     Child[]
  notes        CustomerNote[]
  invoices     Invoice[]
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  authorId   String?
  authorName String?
  note       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Child {
  id           String        @id @default(cuid())
  customerId   String
  name         String
  dob          DateTime?
  age          Int?
  gender       String
  school       String?
  gradeClass   String?
  relationship String
  appointments Appointment[]
  customer     Customer      @relation(fields: [customerId], references: [id])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  details   String?
  createdAt DateTime @default(now())
}

model Appointment {
  id                 String        @id @default(cuid())
  specialistId       String
  customerId         String
  childId            String
  date               DateTime
  startTime          String
  endTime            String
  status             String
  reason             String
  additionalInfo     String?
  cancellationReason String?
  createdAt          DateTime      @default(now())
  advanceAmount      Float         @default(0)
  advancePaid        Float         @default(0)
  balancePaid        Float         @default(0)
  paymentStatus      String        @default("PENDING")
  totalAmount        Float         @default(0)
  child              Child         @relation(fields: [childId], references: [id])
  customer           Customer      @relation(fields: [customerId], references: [id])
  specialist         Specialist    @relation(fields: [specialistId], references: [id])
  invoice            Invoice?
  payment            Payment?
  transactions       Transaction[]
}

model SlotHold {
  id           String   @id @default(cuid())
  specialistId String
  date         DateTime
  startTime    String
  expiresAt    DateTime

  @@unique([specialistId, date, startTime])
}

model Payment {
  id                String      @id @default(cuid())
  appointmentId     String      @unique
  razorpayOrderId   String      @unique
  razorpayPaymentId String?
  amount            Float
  status            String
  createdAt         DateTime    @default(now())
  appointment       Appointment @relation(fields: [appointmentId], references: [id])
}

model Transaction {
  id            String      @id @default(cuid())
  appointmentId String
  amount        Float
  type          String
  method        String
  status        String
  reference     String?
  notes         String?
  date          DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
}

model JobOpening {
  id           String           @id @default(cuid())
  title        String
  department   String
  location     String
  experience   String
  type         String
  description  String
  requirements String?
  isPublished  Boolean          @default(true)
  closingDate  DateTime?
  isFilled     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]
}

model JobApplication {
  id                    String      @id @default(cuid())
  name                  String
  email                 String
  phone                 String
  position              String
  jobOpeningId          String?
  qualifications        String
  experience            String
  currentOrg            String?
  specialisation        String?
  resumeUrl             String
  message               String?
  status                String
  createdAt             DateTime    @default(now())
  category              String      @default("Consultant")
  convertedAt           DateTime?
  convertedSpecialistId String?
  convertedUserId       String?
  photoUrl              String?
  metadata              Json?
  jobOpening            JobOpening? @relation(fields: [jobOpeningId], references: [id])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model EmailLog {
  id        String   @id @default(cuid())
  type      String
  recipient String
  subject   String
  status    String
  relatedId String?
  error     String?
  createdAt DateTime @default(now())
}

model Invoice {
  id            String      @id @default(cuid())
  invoiceNumber String      @unique
  appointmentId String      @unique
  customerId    String
  date          DateTime    @default(now())
  pdfUrl        String?
  token         String      @unique
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  customer      Customer    @relation(fields: [customerId], references: [id])
}
